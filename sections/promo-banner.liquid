<section class="promo-banner">
  <div class="promo-banner-container page-width">
    <div class="promo-banner-content">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <p>{{ section.settings.text }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="promo-button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .promo-banner {
    padding: 90px 0px;
    background: #f3f3f3;
    text-align: center;
  }
  
  .promo-banner-content h2 {
    margin: 0 0 15px;
    font-size: 42px;
  }

  .promo-banner-content p {
    margin: 0 0 30px;
    font-size: 17px;
    line-height: 1.6;
  }

  .promo-button {
    display: inline-block;
    padding: 14px 28px;
    background: #111;
    color: #fff;
    font-weight: 600;
  }

  @media screen and (max-width: 767px) {
    .promo-banner {
      padding: 60px 20px;
    }

    .promo-banner-content h2 {
      font-size: 32px;
    }
  }
</style>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Season. New Style."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Explore our latest collection and find your new favorites."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}
