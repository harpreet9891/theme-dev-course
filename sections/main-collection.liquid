<section class="main-collection">
  <div class="page-width">

    <!-- ========================================
         Collection Header
    ======================================== -->

    <div class="collection-header">
      <h1>{{ collection.title }}</h1>

      {% if collection.description != blank %}
        <div class="collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>


    <!-- ========================================
         Active Filter Detection
    ======================================== -->

    {% assign has_active_filters = false %}

    {% for filter in collection.filters %}

      {% if filter.active_values.size > 0 %}
        {% assign has_active_filters = true %}
      {% endif %}

      {% if filter.type == 'price_range' %}

        {% if filter.min_value.value != blank %}
          {% assign has_active_filters = true %}
        {% endif %}

        {% if filter.max_value.value != blank %}
          {% assign has_active_filters = true %}
        {% endif %}

      {% endif %}

    {% endfor %}


    <!-- ========================================
         Collection Toolbar
    ======================================== -->

    <div class="collection-toolbar">

      <p class="collection-count">
        {{ collection.products_count }}

        {% if collection.products_count == 1 %}
          Product
        {% else %}
          Products
        {% endif %}
      </p>


      <!-- ========================================
           Sorting
           Active filters are preserved
      ======================================== -->

      <form
        class="collection-sort"
        method="get"
        action="{{ collection.url }}"
      >

        {% for filter in collection.filters %}

          {% for value in filter.active_values %}

            <input
              type="hidden"
              name="{{ value.param_name }}"
              value="{{ value.value }}"
            >

          {% endfor %}


          {% if filter.type == 'price_range' %}

            {% if filter.min_value.value != blank %}

              <input
                type="hidden"
                name="{{ filter.min_value.param_name }}"
                value="{{ filter.min_value.value }}"
              >

            {% endif %}


            {% if filter.max_value.value != blank %}

              <input
                type="hidden"
                name="{{ filter.max_value.param_name }}"
                value="{{ filter.max_value.value }}"
              >

            {% endif %}

          {% endif %}

        {% endfor %}


        <label for="SortBy">
          Sort by
        </label>

        <select
          id="SortBy"
          name="sort_by"
          onchange="this.form.submit()"
        >

          {% assign sort_by = collection.sort_by | default: collection.default_sort_by %}

          {% for option in collection.sort_options %}

            <option
              value="{{ option.value }}"
              {% if option.value == sort_by %}
                selected
              {% endif %}
            >
              {{ option.name }}
            </option>

          {% endfor %}

        </select>

      </form>

    </div>


    <!-- ========================================
         Active Filters
    ======================================== -->

    {% if has_active_filters %}

      <div class="collection-active-filters">

        <div class="collection-active-filters-list">

          <span class="collection-active-filters-title">
            Active Filters:
          </span>


          {% for filter in collection.filters %}


            <!-- List / Boolean Active Values -->

            {% for value in filter.active_values %}

              <a
                href="{{ value.url_to_remove }}"
                class="collection-active-filter"
              >

                <span>
                  {{ value.label }}
                </span>

                <span
                  class="collection-active-filter-remove"
                  aria-hidden="true"
                >
                  ×
                </span>

              </a>

            {% endfor %}


            <!-- Price Min -->

            {% if filter.type == 'price_range' %}

              {% if filter.min_value.value != blank %}

                <a
                  href="{{ filter.min_value.url_to_remove }}"
                  class="collection-active-filter"
                >

                  <span>
                    From {{ filter.min_value.value | money }}
                  </span>

                  <span
                    class="collection-active-filter-remove"
                    aria-hidden="true"
                  >
                    ×
                  </span>

                </a>

              {% endif %}


              <!-- Price Max -->

              {% if filter.max_value.value != blank %}

                <a
                  href="{{ filter.max_value.url_to_remove }}"
                  class="collection-active-filter"
                >

                  <span>
                    Up to {{ filter.max_value.value | money }}
                  </span>

                  <span
                    class="collection-active-filter-remove"
                    aria-hidden="true"
                  >
                    ×
                  </span>

                </a>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>


        <!-- Clear All -->

        <a
          href="{{ collection.url }}"
          class="collection-active-filters-clear"
        >
          Clear all
        </a>

      </div>

    {% endif %}


    <!-- ========================================
         Mobile Filter Button
    ======================================== -->

    {% if collection.filters.size > 0 %}

      <button
        type="button"
        class="mobile-filter-button"
        onclick="
          document.querySelector('.collection-filter-sidebar').classList.add('is-open');
          document.querySelector('.collection-filter-overlay').classList.add('is-visible');
          document.body.classList.add('filter-drawer-open');
        "
      >
        Filters
      </button>


      <!-- Mobile Overlay -->

      <div
        class="collection-filter-overlay"
        onclick="
          document.querySelector('.collection-filter-sidebar').classList.remove('is-open');
          document.querySelector('.collection-filter-overlay').classList.remove('is-visible');
          document.body.classList.remove('filter-drawer-open');
        "
      ></div>

    {% endif %}


    <!-- ========================================
         Collection Content
    ======================================== -->

    <div class="collection-content">


      <!-- ========================================
           Filter Sidebar
      ======================================== -->

      {% if collection.filters.size > 0 %}

        <aside class="collection-filter-sidebar">


          <!-- Filter Header -->

          <div class="collection-filter-header">

            <h2>
              Filters
            </h2>

            <button
              type="button"
              class="collection-filter-close"
              aria-label="Close filters"
              onclick="
                document.querySelector('.collection-filter-sidebar').classList.remove('is-open');
                document.querySelector('.collection-filter-overlay').classList.remove('is-visible');
                document.body.classList.remove('filter-drawer-open');
              "
            >
              ×
            </button>

          </div>


          <!-- Filter Form -->

          <form
            method="get"
            action="{{ collection.url }}"
            class="collection-filter-form"
          >

            {% for filter in collection.filters %}

              <div class="collection-filter">

                <h3 class="collection-filter-title">
                  {{ filter.label }}
                </h3>


                {% case filter.type %}


                  <!-- ========================================
                       Boolean Filter
                       Example: Availability
                  ======================================== -->

                  {% when 'boolean' %}

                    <div class="collection-filter-options">

                      {% if filter.true_value != blank %}

                        <label class="collection-filter-option">

                          <input
                            type="checkbox"
                            name="{{ filter.true_value.param_name }}"
                            value="{{ filter.true_value.value }}"
                            {% if filter.true_value.active %}
                              checked
                            {% endif %}

                            {% if filter.true_value.count == 0 and filter.true_value.active == false %}
                              disabled
                            {% endif %}
                          >

                          <span class="collection-filter-checkbox"></span>

                          <span class="collection-filter-label">
                            {{ filter.true_value.label }}
                          </span>

                          {% if filter.true_value.count != blank %}

                            <span class="collection-filter-count">
                              {{ filter.true_value.count }}
                            </span>

                          {% endif %}

                        </label>

                      {% endif %}


                      {% if filter.false_value != blank %}

                        <label class="collection-filter-option">

                          <input
                            type="checkbox"
                            name="{{ filter.false_value.param_name }}"
                            value="{{ filter.false_value.value }}"
                            {% if filter.false_value.active %}
                              checked
                            {% endif %}

                            {% if filter.false_value.count == 0 and filter.false_value.active == false %}
                              disabled
                            {% endif %}
                          >

                          <span class="collection-filter-checkbox"></span>

                          <span class="collection-filter-label">
                            {{ filter.false_value.label }}
                          </span>

                          {% if filter.false_value.count != blank %}

                            <span class="collection-filter-count">
                              {{ filter.false_value.count }}
                            </span>

                          {% endif %}

                        </label>

                      {% endif %}

                    </div>


                  <!-- ========================================
                       List Filter
                       Vendor / Product Type / Tags etc.
                  ======================================== -->

                  {% when 'list' %}

                    <div class="collection-filter-options">

                      {% for value in filter.values %}

                        <label class="collection-filter-option">

                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}

                            {% if value.count == 0 and value.active == false %}
                              disabled
                            {% endif %}
                          >

                          <span class="collection-filter-checkbox"></span>

                          <span class="collection-filter-label">
                            {{ value.label }}
                          </span>

                          {% if value.count != blank %}

                            <span class="collection-filter-count">
                              {{ value.count }}
                            </span>

                          {% endif %}

                        </label>

                      {% endfor %}

                    </div>


                  <!-- ========================================
                       Price Range
                  ======================================== -->

                  {% when 'price_range' %}

                    <div class="collection-filter-price">

                      <div class="collection-price-field">

                        <label
                          for="Filter-{{ filter.min_value.param_name }}"
                        >
                          Min
                        </label>

                        <input
                          type="number"
                          id="Filter-{{ filter.min_value.param_name }}"
                          name="{{ filter.min_value.param_name }}"
                          min="0"
                          placeholder="0"

                          {% if filter.min_value.value != blank %}
                            value="{{ filter.min_value.value | divided_by: 100 }}"
                          {% endif %}
                        >

                      </div>


                      <span class="collection-price-separator">
                        –
                      </span>


                      <div class="collection-price-field">

                        <label
                          for="Filter-{{ filter.max_value.param_name }}"
                        >
                          Max
                        </label>

                        <input
                          type="number"
                          id="Filter-{{ filter.max_value.param_name }}"
                          name="{{ filter.max_value.param_name }}"
                          min="0"
                          placeholder="1000"

                          {% if filter.max_value.value != blank %}
                            value="{{ filter.max_value.value | divided_by: 100 }}"
                          {% endif %}
                        >

                      </div>

                    </div>

                {% endcase %}

              </div>

            {% endfor %}


            <!-- ========================================
                 Filter Actions
            ======================================== -->

            <div class="collection-filter-actions">

              <button
                type="submit"
                class="collection-filter-apply"
              >
                Apply Filters
              </button>


              {% if has_active_filters %}

                <a
                  href="{{ collection.url }}"
                  class="collection-filter-clear"
                >
                  Clear All
                </a>

              {% endif %}

            </div>

          </form>

        </aside>

      {% endif %}


      <!-- ========================================
           Products
      ======================================== -->

      <div class="collection-products-area">

        {% paginate collection.products by section.settings.products_per_page %}

          {% if collection.products.size > 0 %}

            <div class="collection-grid">

              {% for product in collection.products %}

                <article class="collection-product-card">

                  <!-- Product Image -->

                  <a
                    href="{{ product.url }}"
                    class="collection-product-image"
                  >

                    {% if product.featured_image != blank %}

                      {{
                        product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '400, 600, 800',
                          sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 50vw',
                          alt: product.featured_image.alt
                      }}

                    {% else %}

                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}

                    {% endif %}

                  </a>


                  <!-- Product Info -->

                  <div class="collection-product-info">

                    <h2 class="collection-product-title">

                      <a href="{{ product.url }}">
                        {{ product.title }}
                      </a>

                    </h2>


                    <!-- Price -->

                    <div class="collection-product-price">

                      {% if product.compare_at_price > product.price %}

                        <span class="collection-price">
                          {{ product.price | money }}
                        </span>

                        <span class="collection-compare-price">
                          {{ product.compare_at_price | money }}
                        </span>

                      {% else %}

                        <span class="collection-price">
                          {{ product.price | money }}
                        </span>

                      {% endif %}

                    </div>


                    <!-- Add To Cart -->

                    {% if product.available %}

                      <form
                        action="{{ routes.cart_add_url }}"
                        method="post"
                        class="collection-add-form"
                      >

                        <input
                          type="hidden"
                          name="id"
                          value="{{ product.selected_or_first_available_variant.id }}"
                        >

                        <input
                          type="hidden"
                          name="quantity"
                          value="1"
                        >

                        <button
                          type="submit"
                          class="collection-add-button"
                        >
                          Add to Cart
                        </button>

                      </form>

                    {% else %}

                      <button
                        type="button"
                        class="collection-add-button"
                        disabled
                      >
                        Sold Out
                      </button>

                    {% endif %}

                  </div>

                </article>

              {% endfor %}

            </div>


            <!-- ========================================
                 Pagination
            ======================================== -->

            {% if paginate.pages > 1 %}

              <nav
                class="collection-pagination"
                aria-label="Pagination"
              >
                {{ paginate | default_pagination }}
              </nav>

            {% endif %}


          {% else %}

            <!-- Empty State -->

            <div class="collection-empty">

              <h2>
                No products found
              </h2>

              <p>
                There are currently no products matching your filters.
              </p>

              <a
                href="{{ collection.url }}"
                class="collection-empty-button"
              >
                Clear Filters
              </a>

            </div>

          {% endif %}

        {% endpaginate %}

      </div>

    </div>

  </div>
</section>



<style>

/* ========================================
   Main Collection
======================================== */

.main-collection {
  padding: 70px 0;
}


/* ========================================
   Header
======================================== */

.collection-header {
  margin-bottom: 45px;
  text-align: center;
}

.collection-header h1 {
  margin: 0 0 15px;
  font-size: 42px;
  line-height: 1.2;
}

.collection-description {
  max-width: 700px;
  margin: 0 auto;
  color: #666;
  line-height: 1.7;
}


/* ========================================
   Toolbar
======================================== */

.collection-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 25px;
  padding-bottom: 20px;

  border-bottom: 1px solid #e5e5e5;
}

.collection-count {
  margin: 0;
  color: #666;
  font-size: 14px;
}

.collection-sort {
  display: flex;
  align-items: center;
  gap: 10px;
}

.collection-sort label {
  font-size: 14px;
}

.collection-sort select {
  min-width: 180px;
  padding: 10px 35px 10px 12px;

  border: 1px solid #ccc;
  background: #fff;

  font-size: 14px;
  cursor: pointer;
}


/* ========================================
   Active Filters
======================================== */

.collection-active-filters {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin-bottom: 25px;
  padding: 14px 16px;

  border: 1px solid #e5e5e5;
  background: #fafafa;
}

.collection-active-filters-list {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
}

.collection-active-filters-title {
  margin-right: 5px;
  font-size: 13px;
  font-weight: 600;
}

.collection-active-filter {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 7px 10px;

  border: 1px solid #ddd;
  background: #fff;

  color: #111;

  font-size: 13px;
  text-decoration: none;
}

.collection-active-filter:hover {
  border-color: #111;
}

.collection-active-filter-remove {
  font-size: 17px;
  line-height: 12px;
}

.collection-active-filters-clear {
  flex-shrink: 0;
  color: #111;
  font-size: 13px;
  text-decoration: underline;
}


/* ========================================
   Collection Content
======================================== */

.collection-content {
  display: grid;

  grid-template-columns: 230px 1fr;

  gap: 35px;

  align-items: start;
}


/* ========================================
   Sidebar
======================================== */

.collection-filter-sidebar {
  position: sticky;
  top: 30px;
}

.collection-filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 18px;

  border-bottom: 1px solid #ddd;
}

.collection-filter-header h2 {
  margin: 0;

  font-size: 18px;
  font-weight: 600;
}

.collection-filter-close {
  display: none;

  border: 0;
  background: none;

  font-size: 28px;
  line-height: 1;

  cursor: pointer;
}


/* ========================================
   Filter
======================================== */

.collection-filter {
  padding: 22px 0;

  border-bottom: 1px solid #e5e5e5;
}

.collection-filter-title {
  margin: 0 0 15px;

  font-size: 14px;
  font-weight: 600;
}

.collection-filter-options {
  display: flex;
  flex-direction: column;
  gap: 11px;
}

.collection-filter-option {
  position: relative;

  display: flex;
  align-items: center;

  gap: 9px;

  font-size: 14px;

  cursor: pointer;
}

.collection-filter-option input {
  position: absolute;

  opacity: 0;

  pointer-events: none;
}

.collection-filter-option input:disabled + .collection-filter-checkbox {
  opacity: 0.35;
}

.collection-filter-checkbox {
  width: 16px;
  height: 16px;

  flex: 0 0 16px;

  border: 1px solid #aaa;

  background: #fff;
}

.collection-filter-option input:checked + .collection-filter-checkbox {
  border-color: #111;

  background: #111;

  box-shadow: inset 0 0 0 3px #fff;
}

.collection-filter-label {
  flex: 1;
}

.collection-filter-count {
  color: #888;
  font-size: 12px;
}


/* ========================================
   Price
======================================== */

.collection-filter-price {
  display: flex;

  align-items: flex-end;

  gap: 8px;
}

.collection-price-field {
  flex: 1;
}

.collection-price-field label {
  display: block;

  margin-bottom: 6px;

  color: #666;

  font-size: 12px;
}

.collection-price-field input {
  width: 100%;

  box-sizing: border-box;

  padding: 9px 8px;

  border: 1px solid #ccc;

  background: #fff;

  font-size: 13px;
}

.collection-price-field input:focus {
  outline: none;

  border-color: #111;
}

.collection-price-separator {
  padding-bottom: 9px;
  color: #777;
}


/* ========================================
   Filter Actions
======================================== */

.collection-filter-actions {
  display: flex;

  flex-direction: column;

  gap: 10px;

  padding-top: 20px;
}

.collection-filter-apply {
  width: 100%;

  padding: 12px 15px;

  border: 1px solid #111;

  background: #111;

  color: #fff;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;
}

.collection-filter-apply:hover {
  background: #333;
}

.collection-filter-clear {
  display: block;

  padding: 10px;

  color: #111;

  font-size: 13px;

  text-align: center;

  text-decoration: underline;
}


/* ========================================
   Product Area
======================================== */

.collection-products-area {
  min-width: 0;
}

.collection-grid {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 30px;
}


/* ========================================
   Product Card
======================================== */

.collection-product-card {
  min-width: 0;
}

.collection-product-image {
  display: block;

  overflow: hidden;

  aspect-ratio: 1 / 1;

  background: #f5f5f5;
}

.collection-product-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;

  transition: transform 0.4s ease;
}

.collection-product-image:hover img {
  transform: scale(1.04);
}

.collection-product-info {
  padding-top: 15px;
}

.collection-product-title {
  margin: 0 0 8px;

  font-size: 17px;

  line-height: 1.4;
}

.collection-product-title a {
  color: #111;
  text-decoration: none;
}

.collection-product-title a:hover {
  text-decoration: underline;
}


/* ========================================
   Price
======================================== */

.collection-product-price {
  display: flex;

  align-items: center;

  gap: 8px;

  margin-bottom: 15px;
}

.collection-price {
  font-size: 15px;
  font-weight: 600;
}

.collection-compare-price {
  color: #888;

  font-size: 14px;

  text-decoration: line-through;
}


/* ========================================
   Add To Cart
======================================== */

.collection-add-form {
  margin: 0;
}

.collection-add-button {
  width: 100%;

  padding: 12px 15px;

  border: 1px solid #111;

  background: #111;

  color: #fff;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;
}

.collection-add-button:hover:not(:disabled) {
  background: #333;
}

.collection-add-button:disabled {
  opacity: 0.5;

  cursor: not-allowed;
}


/* ========================================
   Pagination
======================================== */

.collection-pagination {
  display: flex;

  justify-content: center;

  margin-top: 50px;
}

.collection-pagination a,
.collection-pagination span {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  min-width: 40px;
  height: 40px;

  margin: 0 3px;

  padding: 0 10px;

  border: 1px solid #ddd;

  color: #111;

  text-decoration: none;
}


/* ========================================
   Empty State
======================================== */

.collection-empty {
  padding: 80px 20px;

  text-align: center;
}

.collection-empty h2 {
  margin: 0 0 10px;
}

.collection-empty p {
  margin: 0 0 25px;

  color: #666;
}

.collection-empty-button {
  display: inline-block;

  padding: 13px 25px;

  background: #111;

  color: #fff;

  text-decoration: none;
}


/* ========================================
   Mobile Filter Button
======================================== */

.mobile-filter-button {
  display: none;
}


/* ========================================
   Mobile Overlay
======================================== */

.collection-filter-overlay {
  display: none;
}


/* ========================================
   Tablet
======================================== */

@media screen and (max-width: 989px) {

  .main-collection {
    padding: 55px 0;
  }

  .collection-content {
    grid-template-columns: 200px 1fr;
    gap: 25px;
  }

  .collection-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
  }

  .collection-header h1 {
    font-size: 36px;
  }

}


/* ========================================
   Mobile
======================================== */

@media screen and (max-width: 749px) {

  .main-collection {
    padding: 45px 20px;
  }


  /* Header */

  .collection-header {
    margin-bottom: 30px;
  }

  .collection-header h1 {
    font-size: 30px;
  }


  /* Toolbar */

  .collection-toolbar {
    align-items: flex-start;

    flex-direction: column;

    gap: 15px;

    margin-bottom: 15px;
  }

  .collection-sort {
    width: 100%;

    justify-content: space-between;
  }

  .collection-sort select {
    flex: 1;
  }


  /* Active Filters */

  .collection-active-filters {
    align-items: flex-start;

    flex-direction: column;

    gap: 12px;

    padding: 12px;
  }

  .collection-active-filters-list {
    width: 100%;
  }

  .collection-active-filters-clear {
    align-self: flex-start;
  }


  /* Filter Button */

  .mobile-filter-button {
    display: block;

    width: 100%;

    margin-bottom: 20px;

    padding: 13px 15px;

    border: 1px solid #111;

    background: #fff;

    color: #111;

    font-size: 14px;

    font-weight: 600;

    cursor: pointer;
  }


  /* Content */

  .collection-content {
    display: block;
  }


